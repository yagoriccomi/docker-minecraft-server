# ===================================================================
#  .env - configuracao LOCAL deste PC (copie para ".env" e ajuste)
# ===================================================================
# O .env NAO vai para o git: cada PC tem o seu hardware e as suas escolhas.
# O compose.yaml e os scripts do menu.bat leem daqui. Sem o .env (ou sem uma
# linha), vale o padrao indicado em cada item.
#
# Trocar um valor: use a opcao do menu indicada (ela grava aqui e oferece
# reiniciar o servidor). Editar a mao tambem funciona, mas os valores do
# servidor so valem depois de recriar o container: [2] Parar e [1] Jogar
# (a opcao [9] Reiniciar NAO rele o .env).

# --- Memoria da JVM ---------------------------------------- opcao [M] ---
# Recomendado: 25% da RAM do PC, entre 2G e 32G (8 GB -> 2G, 64 GB -> 16G).
# O menu recusa mais de 50% da RAM. Padrao: 4G.
MC_MEMORY=4G

# --- Distancias -------------------------------------------- opcao [R] ---
# Visao: quantos chunks o servidor ENVIA a cada jogador (o que ele enxerga).
#   Mais = mais rede e RAM; nao muda o que roda no mundo. 3 a 32. Padrao: 10.
MC_VIEW_DISTANCE=10
# Simulacao: quantos chunks RODAM em volta de cada jogador e do bot AFK
#   (mobs, plantas, redstone, farms). E o que pesa na CPU. 5 a 32, de
#   preferencia <= visao. Padrao: 10. As areas com /forceload rodam sempre.
MC_SIMULATION_DISTANCE=10

# --- Areas forcadas (/forceload) ----------------------------- opcao [F] ---
# ligado    = ao dar [1] Jogar, recoloca todas as areas do cadastro
#             (data/forceload-cadastro.json, sincronizado entre os PCs);
# desligado = guarda as areas no cadastro e tira todas (servidor mais leve).
# Cadastrar area nova e pelo console [7]: forceload add x1 z1 x2 z2
# Padrao: ligado.
MC_FORCELOAD=ligado
